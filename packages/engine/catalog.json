{
  "version": 1,
  "charts": [
    {
      "id": "area",
      "name": "Area chart",
      "summary": "Shows how one measure changes over time, with the filled area emphasising volume.",
      "goals": [
        "trend"
      ],
      "data": {
        "fields": [
          {
            "role": "time",
            "count": {
              "min": 1,
              "max": 1
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 1
        }
      },
      "rules": [
        {
          "when": {
            "metric": "timeFields",
            "op": "=",
            "value": 0
          },
          "effect": "exclude",
          "reason": "The filled area implies continuity over time. Without a time field it means nothing.",
          "suggest": "bar-horizontal"
        },
        {
          "when": {
            "metric": "series",
            "op": ">",
            "value": 1
          },
          "effect": "exclude",
          "reason": "Overlapping filled areas hide each other. Several series need lines or a stacked area.",
          "suggest": "multi-line"
        },
        {
          "when": {
            "metric": "hasNegatives",
            "op": "=",
            "value": true
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "An area reads as volume from zero; negative values fill downwards and confuse that reading.",
          "fix": "Use a line chart, which handles negative values cleanly.",
          "suggest": "line"
        },
        {
          "when": {
            "metric": "pointsPerSeries",
            "op": "<",
            "value": 3
          },
          "effect": "penalty",
          "weight": 0.6,
          "reason": "With fewer than 3 points there's no trend to see.",
          "suggest": "kpi-tile-delta"
        },
        {
          "when": {
            "all": [
              {
                "metric": "goal",
                "op": "=",
                "value": "trend"
              },
              {
                "metric": "timeFields",
                "op": "=",
                "value": 1
              }
            ]
          },
          "effect": "boost",
          "weight": 0.3,
          "reason": "One measure over time, where the volume matters, is what an area chart shows."
        },
        {
          "when": {
            "metric": "space",
            "op": "=",
            "value": "tile"
          },
          "effect": "penalty",
          "weight": 0.5,
          "reason": "Axes and labels don't fit in a KPI tile.",
          "suggest": "sparkline"
        }
      ],
      "context": {
        "space": {
          "tile": "poor",
          "card": "good",
          "half": "good",
          "full": "good"
        },
        "audience": {
          "glance": "good",
          "explore": "ok"
        },
        "medium": {
          "dashboard": "good",
          "report": "good",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "line",
          "when": "Direction matters more than volume, or values go negative."
        },
        {
          "id": "stacked-area",
          "when": "A total made of a few parts over time."
        },
        {
          "id": "sparkline",
          "when": "It sits inside a KPI tile."
        }
      ],
      "code": [
        "echarts",
        "recharts",
        "plotly"
      ]
    },
    {
      "id": "bar-horizontal",
      "name": "Horizontal bar chart",
      "summary": "Compares one measure across categories with bars sorted largest first, so the order tells the story.",
      "goals": [
        "compare",
        "ranking"
      ],
      "data": {
        "fields": [
          {
            "role": "category",
            "count": {
              "min": 1,
              "max": 1
            },
            "cardinality": {
              "max": 40,
              "ideal": 8
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 1
        }
      },
      "rules": [
        {
          "when": {
            "all": [
              {
                "metric": "categoryFields",
                "op": "=",
                "value": 0
              },
              {
                "metric": "ordinalFields",
                "op": "=",
                "value": 0
              }
            ]
          },
          "effect": "exclude",
          "reason": "Bars compare categories. Without a category column there's nothing to put on the bars."
        },
        {
          "when": {
            "metric": "timeFields",
            "op": ">",
            "value": 0
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "Your data runs over time; summing it into bars loses the trend.",
          "suggest": "line"
        },
        {
          "when": {
            "all": [
              {
                "metric": "goal",
                "op": "in",
                "value": [
                  "compare",
                  "ranking"
                ]
              },
              {
                "metric": "categoryFields",
                "op": ">=",
                "value": 1
              }
            ]
          },
          "effect": "boost",
          "weight": 0.4,
          "reason": "Bars on a common baseline are the most accurately compared shape."
        },
        {
          "when": {
            "metric": "categories",
            "op": "<",
            "value": 2
          },
          "effect": "penalty",
          "weight": 0.5,
          "reason": "One bar compares nothing.",
          "suggest": "kpi-tile-delta"
        },
        {
          "when": {
            "metric": "categories",
            "op": ">",
            "value": 12
          },
          "effect": "penalty",
          "weight": 0.2,
          "reason": "Beyond 12 bars the tail is folded into \"Other\".",
          "fix": "Show the top items, or use a table for the full list.",
          "suggest": "top-n-table"
        },
        {
          "when": {
            "metric": "maxLabelLength",
            "op": ">",
            "value": 12
          },
          "effect": "boost",
          "weight": 0.1,
          "reason": "Horizontal bars keep long category names readable."
        }
      ],
      "context": {
        "space": {
          "tile": "poor",
          "card": "good",
          "half": "good",
          "full": "good"
        },
        "audience": {
          "glance": "good",
          "explore": "good"
        },
        "medium": {
          "dashboard": "good",
          "report": "good",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "top-n-table",
          "when": "Exact values matter as much as the ranking."
        },
        {
          "id": "stacked-bar",
          "when": "Each category splits into parts."
        },
        {
          "id": "dot-plot",
          "when": "Values are large and close together, so bar lengths look the same."
        }
      ],
      "code": [
        "echarts",
        "recharts",
        "plotly"
      ]
    },
    {
      "id": "cohort-heatmap",
      "name": "Cohort retention heatmap",
      "summary": "For each group of customers who started in the same month, the share who came back in each later month.",
      "goals": [
        "trend",
        "distribution"
      ],
      "data": {
        "fields": [
          {
            "role": "ordinal",
            "count": {
              "min": 1,
              "max": 1
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 1
        }
      },
      "rules": [
        {
          "when": {
            "all": [
              {
                "metric": "categoryFields",
                "op": "=",
                "value": 0
              },
              {
                "metric": "timeFields",
                "op": "=",
                "value": 0
              }
            ]
          },
          "effect": "exclude",
          "reason": "A cohort chart needs a cohort column, e.g. first-order month."
        },
        {
          "when": {
            "metric": "periodIndex",
            "op": "=",
            "value": false
          },
          "effect": "exclude",
          "reason": "It needs a numbered period column, e.g. months_since_first_order (0, 1, 2…)."
        },
        {
          "when": {
            "metric": "periodIndex",
            "op": "=",
            "value": true
          },
          "effect": "boost",
          "weight": 0.6,
          "reason": "Cohorts with numbered periods since they started are exactly what a retention grid shows."
        },
        {
          "when": {
            "metric": "goal",
            "op": "=",
            "value": "trend"
          },
          "effect": "boost",
          "weight": 0.15,
          "reason": "Shows how loyalty changes from one cohort to the next."
        },
        {
          "when": {
            "metric": "categories",
            "op": ">",
            "value": 12
          },
          "effect": "penalty",
          "weight": 0.1,
          "reason": "Only the latest 12 cohorts are shown."
        },
        {
          "when": {
            "metric": "space",
            "op": "in",
            "value": [
              "tile",
              "card"
            ]
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "A cohort grid needs room for every cell's label."
        }
      ],
      "context": {
        "space": {
          "tile": "never",
          "card": "poor",
          "half": "ok",
          "full": "good"
        },
        "audience": {
          "glance": "ok",
          "explore": "good"
        },
        "medium": {
          "dashboard": "good",
          "report": "good",
          "slide": "ok"
        }
      },
      "alternatives": [
        {
          "id": "multi-line",
          "when": "Only a few cohorts matter; one retention curve each."
        },
        {
          "id": "kpi-tile-delta",
          "when": "One headline retention number is enough."
        }
      ],
      "code": [
        "echarts",
        "react",
        "plotly"
      ]
    },
    {
      "id": "data-table",
      "name": "Data table",
      "summary": "Exact values in typed, sortable columns, with only the cells that need attention highlighted.",
      "goals": [
        "compare",
        "ranking"
      ],
      "data": {
        "fields": [
          {
            "role": "category",
            "count": {
              "min": 0,
              "max": 3
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 12
            }
          }
        ],
        "rows": {
          "min": 0
        }
      },
      "rules": [
        {
          "when": {
            "metric": "audience",
            "op": "=",
            "value": "explore"
          },
          "effect": "boost",
          "weight": 0.4,
          "reason": "Analysts look things up; exact values beat any chart."
        },
        {
          "when": {
            "metric": "measureFields",
            "op": ">=",
            "value": 3
          },
          "effect": "boost",
          "weight": 0.3,
          "reason": "Several measures per item read best as columns."
        },
        {
          "when": {
            "metric": "rows",
            "op": ">",
            "value": 20
          },
          "effect": "boost",
          "weight": 0.15,
          "reason": "Many rows; a table with sorting handles them."
        },
        {
          "when": {
            "metric": "audience",
            "op": "=",
            "value": "glance"
          },
          "effect": "penalty",
          "weight": 0.3,
          "reason": "A table has no shape to read at a glance."
        },
        {
          "when": {
            "metric": "space",
            "op": "=",
            "value": "tile"
          },
          "effect": "exclude",
          "reason": "A table doesn't fit in a KPI tile."
        }
      ],
      "context": {
        "space": {
          "tile": "never",
          "card": "ok",
          "half": "good",
          "full": "good"
        },
        "audience": {
          "glance": "poor",
          "explore": "good"
        },
        "medium": {
          "dashboard": "ok",
          "report": "good",
          "slide": "poor"
        }
      },
      "alternatives": [
        {
          "id": "top-n-table",
          "when": "One measure, ranked, with inline bars."
        },
        {
          "id": "bar-horizontal",
          "when": "The ranking matters more than exact values."
        }
      ],
      "code": [
        "vanilla",
        "react",
        "plotly"
      ]
    },
    {
      "id": "donut",
      "name": "Donut chart",
      "summary": "Shows how one total splits into a few parts at one moment, with the total in the middle.",
      "goals": [
        "part-of-whole"
      ],
      "data": {
        "fields": [
          {
            "role": "category",
            "count": {
              "min": 1,
              "max": 1
            },
            "cardinality": {
              "max": 30,
              "ideal": 4
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 1
        }
      },
      "rules": [
        {
          "when": {
            "metric": "categoryFields",
            "op": "=",
            "value": 0
          },
          "effect": "exclude",
          "reason": "A donut splits a total into categories; there's no category column."
        },
        {
          "when": {
            "metric": "timeFields",
            "op": ">",
            "value": 0
          },
          "effect": "exclude",
          "reason": "Your data is a time series. A donut throws time away.",
          "suggest": "stacked-bar"
        },
        {
          "when": {
            "metric": "hasNegatives",
            "op": "=",
            "value": true
          },
          "effect": "exclude",
          "reason": "A donut can't show negative values; a share of a total can't be below zero.",
          "suggest": "bar-horizontal"
        },
        {
          "when": {
            "metric": "categories",
            "op": ">",
            "value": 6
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "More than 6 slices are hard to compare by angle; the tail is folded into \"Other\".",
          "suggest": "bar-horizontal"
        },
        {
          "when": {
            "all": [
              {
                "metric": "goal",
                "op": "=",
                "value": "part-of-whole"
              },
              {
                "metric": "sumsToWhole",
                "op": "=",
                "value": true
              }
            ]
          },
          "effect": "boost",
          "weight": 0.35,
          "reason": "A few parts of one total, at one moment, is what a donut shows."
        },
        {
          "when": {
            "metric": "goal",
            "op": "in",
            "value": [
              "compare",
              "ranking"
            ]
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "Angles are compared less accurately than bar lengths.",
          "suggest": "bar-horizontal"
        }
      ],
      "context": {
        "space": {
          "tile": "ok",
          "card": "good",
          "half": "good",
          "full": "ok"
        },
        "audience": {
          "glance": "good",
          "explore": "poor"
        },
        "medium": {
          "dashboard": "good",
          "report": "ok",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "bar-horizontal",
          "when": "Exact comparison between parts matters."
        },
        {
          "id": "stacked-bar",
          "when": "The mix changes over time."
        },
        {
          "id": "stacked-bar-100",
          "when": "Comparing the mix across several groups."
        }
      ],
      "code": [
        "echarts",
        "recharts",
        "plotly"
      ]
    },
    {
      "id": "funnel",
      "name": "Funnel chart",
      "summary": "Shows how many people reach each step of a process and where most of them drop off.",
      "goals": [
        "flow"
      ],
      "data": {
        "fields": [
          {
            "role": "ordinal",
            "count": {
              "min": 1,
              "max": 1
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 1
        }
      },
      "rules": [
        {
          "when": {
            "metric": "ordinalFields",
            "op": "=",
            "value": 0
          },
          "effect": "penalty",
          "weight": 0.5,
          "reason": "A funnel needs ordered stages. Name the column \"stage\" or \"step\" if your categories are in order.",
          "suggest": "bar-horizontal"
        },
        {
          "when": {
            "metric": "goal",
            "op": "=",
            "value": "flow"
          },
          "effect": "boost",
          "weight": 0.5,
          "reason": "Ordered stages with shrinking counts are exactly what a funnel shows."
        },
        {
          "when": {
            "metric": "timeFields",
            "op": ">",
            "value": 0
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "Your data runs over time; a funnel is one period's totals per stage."
        },
        {
          "when": {
            "metric": "hasNegatives",
            "op": "=",
            "value": true
          },
          "effect": "exclude",
          "reason": "Counts of people at a stage can't be negative."
        },
        {
          "when": {
            "metric": "categories",
            "op": ">",
            "value": 8
          },
          "effect": "penalty",
          "weight": 0.3,
          "reason": "Funnels with more than 8 stages are hard to read; group the minor steps."
        }
      ],
      "context": {
        "space": {
          "tile": "poor",
          "card": "good",
          "half": "good",
          "full": "good"
        },
        "audience": {
          "glance": "good",
          "explore": "good"
        },
        "medium": {
          "dashboard": "good",
          "report": "good",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "bar-horizontal",
          "when": "Stages aren't strictly ordered."
        },
        {
          "id": "data-table",
          "when": "Comparing conversion rates across many segments."
        },
        {
          "id": "sankey",
          "when": "People branch into several paths."
        }
      ],
      "code": [
        "echarts",
        "recharts",
        "plotly"
      ]
    },
    {
      "id": "kpi-tile-delta",
      "name": "KPI tile with change",
      "summary": "One headline number and how it changed since the previous period.",
      "goals": [
        "kpi"
      ],
      "data": {
        "fields": [
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 0,
          "max": 1
        }
      },
      "rules": [
        {
          "when": {
            "metric": "goal",
            "op": "=",
            "value": "kpi"
          },
          "effect": "boost",
          "weight": 0.5,
          "reason": "A single headline number is exactly what a KPI tile is for."
        },
        {
          "when": {
            "metric": "space",
            "op": "=",
            "value": "tile"
          },
          "effect": "boost",
          "weight": 0.3,
          "reason": "Built for small dashboard tiles."
        },
        {
          "when": {
            "all": [
              {
                "metric": "goal",
                "op": "=",
                "value": "trend"
              },
              {
                "metric": "pointsPerSeries",
                "op": ">=",
                "value": 7
              }
            ]
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "You have enough history to show a trend; a single number hides its shape.",
          "fix": "Add a sparkline, or use a line chart.",
          "suggest": "kpi-tile-sparkline"
        },
        {
          "when": {
            "metric": "series",
            "op": ">",
            "value": 1
          },
          "effect": "penalty",
          "weight": 0.3,
          "reason": "One tile shows one number. Several series need one tile each, or a chart."
        },
        {
          "when": {
            "metric": "audience",
            "op": "=",
            "value": "explore"
          },
          "effect": "penalty",
          "weight": 0.2,
          "reason": "Analysts exploring data need the detail behind the number."
        }
      ],
      "context": {
        "space": {
          "tile": "good",
          "card": "good",
          "half": "ok",
          "full": "poor"
        },
        "audience": {
          "glance": "good",
          "explore": "ok"
        },
        "medium": {
          "dashboard": "good",
          "report": "ok",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "kpi-tile-sparkline",
          "when": "The recent trend matters as much as the number."
        },
        {
          "id": "progress-meter",
          "when": "The number is measured against a target."
        },
        {
          "id": "line",
          "when": "The reader needs to see the whole history."
        }
      ],
      "code": [
        "vanilla",
        "react",
        "plotly"
      ]
    },
    {
      "id": "kpi-tile-sparkline",
      "name": "KPI tile with sparkline",
      "summary": "One headline number for the period, its honest change against the previous period, and a sparkline of how it got there.",
      "goals": [
        "kpi",
        "trend"
      ],
      "data": {
        "fields": [
          {
            "role": "time",
            "count": {
              "min": 1,
              "max": 1
            }
          },
          {
            "role": "measure",
            "count": {
              "min": 1,
              "max": 1
            }
          }
        ],
        "rows": {
          "min": 0
        }
      },
      "rules": [
        {
          "when": {
            "metric": "timeFields",
            "op": "=",
            "value": 0
          },
          "effect": "exclude",
          "reason": "The sparkline needs daily data. With a single number, use the KPI tile with change.",
          "suggest": "kpi-tile-delta"
        },
        {
          "when": {
            "metric": "series",
            "op": ">",
            "value": 1
          },
          "effect": "penalty",
          "weight": 0.4,
          "reason": "One tile shows one series. Several series need one tile each."
        },
        {
          "when": {
            "metric": "goal",
            "op": "=",
            "value": "kpi"
          },
          "effect": "boost",
          "weight": 0.45,
          "reason": "A headline number with its trend is what dashboards lead with."
        },
        {
          "when": {
            "metric": "space",
            "op": "in",
            "value": [
              "tile",
              "card"
            ]
          },
          "effect": "boost",
          "weight": 0.4,
          "reason": "Built for dashboard tiles and cards."
        },
        {
          "when": {
            "metric": "pointsPerSeries",
            "op": ">=",
            "value": 7
          },
          "effect": "boost",
          "weight": 0.15,
          "reason": "Enough history for the sparkline to show a shape."
        },
        {
          "when": {
            "metric": "audience",
            "op": "=",
            "value": "explore"
          },
          "effect": "penalty",
          "weight": 0.2,
          "reason": "Analysts exploring need the full chart behind the number.",
          "suggest": "line"
        }
      ],
      "context": {
        "space": {
          "tile": "good",
          "card": "good",
          "half": "ok",
          "full": "poor"
        },
        "audience": {
          "glance": "good",
          "explore": "ok"
        },
        "medium": {
          "dashboard": "good",
          "report": "ok",
          "slide": "good"
        }
      },
      "alternatives": [
        {
          "id": "kpi-tile-delta",
